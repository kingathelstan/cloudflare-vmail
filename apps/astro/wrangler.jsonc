{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vmail-app",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-08-02",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
  // Add AVAILABLE_DOMAINS as a Worker variable
  // Configure BATCH_ADMIN_TOKEN, JWT_SECRET, and TURNSTILE_SECRET with Wrangler Secrets.
	"vars": {
		"COOKIE_EXPIRES_IN_SECONDS": 86400,
		"DEV_MODE": "false",
		"MOCK_EMAIL_COUNT": "5",
		"SITE_DESCRIPTION": "A privacy-focused virtual temporary email service",
		"SITE_NAME": "MiraHikari Mail",
		"TURNSTILE_SITE_KEY": "0x4AAAAAAEEl_pI2rI9rs7qf",
		"USE_MOCK_DATA": "false"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "prod-emails_forward",
			"database_id": "fe17b2fd-b691-4ca3-b913-c070e2845fba",
			"migrations_dir": "../../packages/database/drizzle"
		}
	],
	"placement": {
		"mode": "smart"
	},
"keep_vars": true
}
