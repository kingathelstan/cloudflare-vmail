{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emails-worker",
	"main": "src/index.ts",
    "keep_vars": true,
	"compatibility_date": "2026-08-02",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"vars": {
		"MAX_EMAIL_BYTES": 1500000
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "prod-emails_forward",
			"database_id": "468edbf8-5b9a-4d22-a1f0-a0d717c43d47",
			"migrations_dir": "../../packages/database/drizzle"
		}
	],
	"observability": {
		"enabled": true
	}
}
